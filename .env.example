# Copy this file to .env and fill in real values before deploying.
# The app reads these from the process environment, not from this file directly
# (use `export $(cat .env | xargs)` on Linux/Mac, or a tool like python-dotenv,
# or your hosting provider's "Environment Variables" panel).

# A long random string used to sign session cookies. MUST be changed for any
# real deployment — generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Port the server listens on.
PORT=5000

# Set to 1 only for local development. Never enable in production.
DEBUG=0
